	.feature-ai-mini__logo {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.35rem;
		height: 1.35rem;
		flex: none;
		border-radius: 0.3rem;
		background: rgba(240, 136, 84, 0.12);
		margin-top: 0.02rem;
	}

	.feature-ai-mini__logo img {
		width: 100%;
		height: 100%;
		display: block;
	}

	.feature-ai-mini__response {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.feature-ai-mini__response strong {
		font-size: 0.68rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		color: rgba(17, 17, 17, 0.48);
		margin-bottom: 0.14rem;
	}

	.feature-ai-mini__response span {
		display: block;
	}

	.feature-img--xs {
		max-width: 40%;
		margin: 0 auto;
		border-radius: 1rem !important;
	}

	.feature-sidebar-mini {
		width: min(100%, 12rem);
		margin: 0 auto;
		padding: 0;
	}

	.feature-sidebar-mini__item {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		font-family: var(--sans);
		font-size: 0.9rem;
		font-weight: 500;
		color: #3f3c38;
	}

	.feature-sidebar-mini__item + .feature-sidebar-mini__item {
		margin-top: 1rem;
	}

	.feature-sidebar-mini__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 1.1rem;
		height: 1.1rem;
		flex: none;
	}

	.feature-sidebar-mini__icon svg {
		width: 100%;
		height: 100%;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.feature-sidebar-mini__item[data-kind="daily-note"] .feature-sidebar-mini__icon {
		color: #4f9cf4;
	}

	.feature-sidebar-mini__item[data-kind="tasks"] .feature-sidebar-mini__icon {
		color: #e2b109;
	}

	.feature-sidebar-mini__item[data-kind="calendar"] .feature-sidebar-mini__icon {
		color: #f27f88;
	}

	.feature-command-mini {
		margin-top: 1.2rem;
		border: 1px solid rgba(17, 17, 17, 0.08);
		border-radius: 0.65rem;
		overflow: hidden;
		background: rgba(255, 255, 255, 0.62);
	}

	.feature-command-mini__input {
		display: flex;
		align-items: center;
		gap: 0.55rem;
		padding: 0.72rem 0.85rem;
		border-bottom: 1px solid rgba(17, 17, 17, 0.06);
	}

	.feature-command-mini__search-icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 0.95rem;
		height: 0.95rem;
		color: rgba(17, 17, 17, 0.42);
		flex: none;
	}

	.feature-command-mini__search-icon svg {
		width: 100%;
		height: 100%;
		fill: none;
		stroke: currentColor;
		stroke-width: 1.4;
		stroke-linecap: round;
		stroke-linejoin: round;
	}

	.feature-command-mini__query {
		flex: 1;
		min-width: 0;
		font-family: var(--sans);
		font-size: 0.8rem;
		color: rgba(17, 17, 17, 0.82);
	}

	.feature-command-mini__shortcut {
		display: inline-flex;
		align-items: center;
		padding: 0.14rem 0.34rem;
		border-radius: 0.28rem;
		border: 1px solid rgba(17, 17, 17, 0.08);
		background: rgba(255, 255, 255, 0.54);
		font-family: var(--sans);
		font-size: 0.62rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: rgba(17, 17, 17, 0.5);
	}

	.feature-command-mini__results {
		padding: 0.55rem;
	}

	.feature-command-mini__label {
		padding: 0 0.3rem 0.35rem;
		font-family: var(--sans);
		font-size: 0.64rem;
		font-weight: 600;
		letter-spacing: 0.01em;
		text-transform: none;
		color: rgba(17, 17, 17, 0.5);
	}

	.feature-command-mini__item {
		padding: 0.52rem 0.6rem;
		border-radius: 0.45rem;
	}

	.feature-command-mini__item.is-active {
		background: rgba(17, 17, 17, 0.04);
	}

	.feature-command-mini__item strong {
		display: block;
		font-family: var(--sans);
		font-size: 0.76rem;
		font-weight: 600;
		line-height: 1.3;
		color: rgba(17, 17, 17, 0.82);
	}

	.feature-command-mini__item small {
		display: block;
		margin-top: 0.08rem;
		font-family: var(--sans);
		font-size: 0.62rem;
		letter-spacing: 0.03em;
		color: rgba(17, 17, 17, 0.42);
	}

	.feature-customize-mini {
		margin-top: 1.2rem;
		display: flex;
		flex-direction: column;
		gap: 0.8rem;
	}

	.feature-customize-mini__themes {
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		gap: 0.35rem;
		width: 100%;
	}

	.feature-customize-mini__themes span {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 0.34rem 0.5rem;
		border: 1px solid rgba(17, 17, 17, 0.08);
		border-radius: 0.38rem;
		background: rgba(255, 255, 255, 0.42);
		font-family: var(--sans);
		font-size: 0.68rem;
		color: rgba(17, 17, 17, 0.56);
		text-align: center;
		line-height: 1.25;
	}

	.feature-customize-mini__themes .is-active {
		border-color: rgba(17, 17, 17, 0.16);
		background: rgba(17, 17, 17, 0.9);
		color: rgba(255, 255, 255, 0.94);
	}

	.feature-customize-mini__swatches {
		display: flex;
		align-items: center;
		gap: 0.45rem;
	}

	.feature-customize-mini__swatches span {
		display: inline-flex;
		width: 1rem;
		height: 1rem;
		border-radius: 0.28rem;
		box-shadow: inset 0 0 0 1px rgba(17, 17, 17, 0.08);
	}

	.feature-customize-mini__type {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.8rem;
		padding: 0.8rem 0.9rem;
		border: 1px solid rgba(17, 17, 17, 0.08);
		border-radius: 0.6rem;
		background: rgba(255, 255, 255, 0.56);
	}

	.feature-customize-mini__sample {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}

	.feature-customize-mini__title {
		font-family: var(--sans);
		font-size: 0.92rem;
		font-weight: 600;
		line-height: 1.2;
		color: rgba(17, 17, 17, 0.84);
	}

	.feature-customize-mini__meta {
		margin-top: 0.14rem;
		font-family: var(--sans);
		font-size: 0.62rem;
		letter-spacing: 0.04em;
		color: rgba(17, 17, 17, 0.42);
	}

	.feature-customize-mini__shortcut {
		display: inline-flex;
		align-items: center;
		padding: 0.2rem 0.42rem;
		border-radius: 0.28rem;
		border: 1px solid rgba(17, 17, 17, 0.08);
		background: rgba(255, 255, 255, 0.54);
		font-family: var(--sans);
		font-size: 0.62rem;
		font-weight: 600;
		letter-spacing: 0.04em;
		color: rgba(17, 17, 17, 0.48);
		white-space: nowrap;
	}

	.feature-eyebrow {
		font-family: var(--sans);
		font-size: 0.78rem;
		font-weight: 500;
		color: rgba(70, 63, 56, 0.7);
		margin-bottom: 0.6rem;
	}

	.feature-heading {
		font-family: var(--serif);
		font-size: clamp(1.3rem, 3vw, 1.7rem);
		font-weight: 400;
		line-height: 1.25;
		color: var(--ink);
		margin-bottom: 0.8rem;
	}

	.feature-body {
		font-family: var(--sans);
		font-size: 0.88rem;
		color: var(--muted);
		line-height: 1.7;
	}

	@media (max-width: 640px) {
		.feature-card-row {
			grid-template-columns: 1fr;
		}
		.feature-card--wide.feature-card--has-img {
			grid-template-columns: 1fr;
			padding-right: 2.4rem;
		}
	}

	/* ── Privacy grid ── */
	.privacy-section .label {
		display: inline-flex;
		align-items: center;
		gap: 0.45rem;
		width: fit-content;
		margin-inline: auto;
		color: rgba(166, 97, 17, 0.82);
	}

	.privacy-section .label::before {
		content: "";
		width: 0.42rem;
		height: 0.42rem;
		border-radius: 999px;
		background: var(--accent);
		box-shadow: 0 0 0 0.22rem rgba(255, 159, 10, 0.14);
	}

	.privacy-section .section-sub {
		max-width: 34rem;
	}

	.privacy-shell {
		width: min(1040px, 96vw);
		margin: 1rem auto 0;
		position: relative;
		left: 50%;
		transform: translateX(-50%);
		border: 1px solid rgba(123, 103, 79, 0.14);
		border-radius: 1.65rem;
		background: rgba(249, 245, 238, 0.98);
		content-visibility: auto;
		contain-intrinsic-size: 860px;
		overflow: hidden;
	}

	.privacy-shell__intro {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) minmax(16rem, 0.9fr);
		gap: 1.4rem;
		align-items: end;
		padding: 1.55rem 1.65rem 1.45rem;
		border-bottom: 1px solid rgba(123, 103, 79, 0.12);
	}

	.privacy-shell__copy {
		max-width: 38rem;
	}

	.privacy-shell__eyebrow {
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.12em;
		text-transform: uppercase;
		color: rgba(93, 81, 69, 0.52);
		margin-bottom: 0.5rem;
	}

	.privacy-shell__title {
		font-family: var(--serif);
		font-size: clamp(1.55rem, 3vw, 2.1rem);
		font-weight: 400;
		line-height: 1.05;
		letter-spacing: -0.03em;
		color: var(--ink);
	}

	.privacy-shell__body {
		margin-top: 0.65rem;
		font-size: 0.9rem;
		line-height: 1.75;
		color: rgba(93, 81, 69, 0.82);
	}

	.privacy-shell__signal {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin-top: 0.9rem;
		padding: 0.38rem 0.72rem 0.38rem 0.46rem;
		border: 1px solid rgba(255, 159, 10, 0.16);
		border-radius: 999px;
		background: rgba(255, 249, 241, 0.92);
		font-size: 0.71rem;
		font-weight: 600;
		letter-spacing: 0.02em;
		color: rgba(124, 77, 17, 0.82);
	}

	.privacy-shell__signal span {
		width: 0.46rem;
		height: 0.46rem;
		border-radius: 999px;
		background: var(--accent);
		flex: none;
	}

	.privacy-shell__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		justify-content: flex-end;
	}

	.privacy-shell__chips span {
		display: inline-flex;
		align-items: center;
		gap: 0.42rem;
		padding: 0.42rem 0.72rem;
		border-radius: 999px;
		border: 1px solid rgba(123, 103, 79, 0.12);
		background: rgba(255, 255, 255, 0.62);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.05em;
		color: rgba(80, 69, 57, 0.72);
	}

	.privacy-shell__chips span::before {
		content: "";
		width: 0.34rem;
		height: 0.34rem;
		border-radius: 999px;
		background: rgba(123, 103, 79, 0.34);
		flex: none;
	}

	.privacy-shell__chips span:nth-child(1)::before { background: var(--accent); }
	.privacy-shell__chips span:nth-child(2)::before { background: #5d7a62; }
	.privacy-shell__chips span:nth-child(3)::before { background: #6883a4; }
	.privacy-shell__chips span:nth-child(4)::before { background: #936373; }

	.privacy-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.95fr) minmax(0, 0.95fr);
		grid-template-areas:
			"private files files"
			"private light key";
		gap: 0.85rem;
		padding: 0.85rem;
		contain: layout paint;
	}

	.privacy-cell {
		--privacy-card-bg: rgba(249, 245, 238, 0.98);
		--privacy-card-icon-bg: rgba(255, 255, 255, 0.72);
		--privacy-card-icon-color: rgba(92, 77, 60, 0.88);
		--privacy-card-border: rgba(123, 103, 79, 0.1);
		--privacy-card-preview-border: rgba(123, 103, 79, 0.08);
		--privacy-card-preview-bg: rgba(255, 255, 255, 0.52);
		--privacy-card-pill-bg: rgba(255, 255, 255, 0.64);
		--privacy-card-pill-color: rgba(73, 64, 55, 0.72);
		--privacy-card-accent: rgba(123, 103, 79, 0.52);
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		min-height: 15rem;
		padding: 1.45rem 1.45rem 1.3rem;
		text-align: left;
		border: 1px solid var(--privacy-card-border);
		border-radius: 1.15rem;
		background: var(--privacy-card-bg);
		contain: layout paint;
	}

	.privacy-cell::after {
		content: "";
		position: absolute;
		top: 1rem;
		right: 1rem;
		width: 3rem;
		height: 0.65rem;
		border-top: 1px dashed var(--privacy-card-accent);
		border-bottom: 1px solid transparent;
		opacity: 0.58;
		pointer-events: none;
	}

	.privacy-cell--feature {
		grid-area: private;
		min-height: 100%;
	}

	.privacy-cell--wide {
		grid-area: files;
	}

	.privacy-cell--light { grid-area: light; }

	.privacy-cell--key { grid-area: key; }

	.privacy-cell--compact {
		min-height: 13.5rem;
	}

	.privacy-cell--private {
		--privacy-card-bg: rgba(255, 246, 237, 0.96);
		--privacy-card-border: rgba(199, 151, 95, 0.18);
		--privacy-card-preview-border: rgba(199, 151, 95, 0.18);
		--privacy-card-preview-bg: rgba(255, 251, 245, 0.88);
		--privacy-card-pill-bg: rgba(255, 250, 245, 0.86);
		--privacy-card-pill-color: rgba(116, 78, 30, 0.78);
		--privacy-card-accent: rgba(184, 123, 44, 0.62);
		--privacy-card-icon-bg: rgba(238, 230, 218, 0.92);
		--privacy-card-icon-color: #675543;
	}

	.privacy-cell--files {
		--privacy-card-bg: rgba(241, 247, 241, 0.96);
		--privacy-card-border: rgba(116, 147, 122, 0.18);
		--privacy-card-preview-border: rgba(116, 147, 122, 0.18);
		--privacy-card-preview-bg: rgba(250, 253, 250, 0.9);
		--privacy-card-pill-bg: rgba(248, 252, 248, 0.88);
		--privacy-card-pill-color: rgba(73, 99, 78, 0.78);
		--privacy-card-accent: rgba(91, 129, 98, 0.58);
		--privacy-card-icon-bg: rgba(228, 238, 228, 0.94);
		--privacy-card-icon-color: #4a6650;
	}

	.privacy-cell--light {
		--privacy-card-bg: rgba(240, 245, 251, 0.96);
		--privacy-card-border: rgba(119, 145, 181, 0.18);
		--privacy-card-preview-border: rgba(119, 145, 181, 0.18);
		--privacy-card-preview-bg: rgba(250, 252, 255, 0.9);
		--privacy-card-pill-bg: rgba(248, 251, 255, 0.9);
		--privacy-card-pill-color: rgba(74, 96, 129, 0.8);
		--privacy-card-accent: rgba(95, 124, 163, 0.56);
		--privacy-card-icon-bg: rgba(228, 234, 242, 0.94);
		--privacy-card-icon-color: #4d6481;
	}

	.privacy-cell--key {
		--privacy-card-bg: rgba(247, 241, 243, 0.96);
		--privacy-card-border: rgba(155, 118, 132, 0.18);
		--privacy-card-preview-border: rgba(155, 118, 132, 0.18);
		--privacy-card-preview-bg: rgba(253, 249, 250, 0.9);
		--privacy-card-pill-bg: rgba(251, 247, 248, 0.9);
		--privacy-card-pill-color: rgba(117, 81, 95, 0.8);
		--privacy-card-accent: rgba(146, 99, 117, 0.56);
		--privacy-card-icon-bg: rgba(239, 229, 231, 0.94);
		--privacy-card-icon-color: #7b5360;
	}

	.privacy-cell__icon {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		width: 3.05rem;
		height: 3.05rem;
		border-radius: 1rem;
		background: var(--privacy-card-icon-bg);
		color: var(--privacy-card-icon-color);
		box-shadow: inset 0 0 0 1px var(--privacy-card-preview-border);
	}

	.privacy-cell__icon img {
		width: 1.35rem;
		height: 1.35rem;
		display: block;
	}

	.privacy-card-title {
		margin-top: 1.05rem;
		font-size: 1.1rem;
		font-weight: 600;
		letter-spacing: -0.02em;
		color: rgba(33, 29, 25, 0.96);
	}

	.privacy-card-subtitle {
		margin-top: 0.45rem;
		max-width: 28rem;
		font-size: 0.92rem;
		line-height: 1.55;
		color: rgba(93, 81, 69, 0.78);
	}

	.privacy-preview {
		position: relative;
		width: 100%;
		margin-top: 1.4rem;
		padding: 1rem 1.05rem;
		border-radius: 1rem;
		border: 1px solid var(--privacy-card-preview-border);
		background: var(--privacy-card-preview-bg);
		contain: paint;
	}

	.privacy-preview::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.8rem;
		bottom: 0.8rem;
		width: 0.2rem;
		border-radius: 999px;
		background: var(--privacy-card-accent);
		opacity: 0.82;
	}

	.privacy-preview--stack {
		display: flex;
		flex-direction: column;
		gap: 0.9rem;
	}

	.privacy-preview__metric {
		display: flex;
		align-items: end;
		gap: 0.55rem;
	}

	.privacy-stat {
		font-family: var(--serif);
		font-size: clamp(2.15rem, 5vw, 2.9rem);
		font-weight: 400;
		letter-spacing: -0.04em;
		line-height: 0.9;
		color: rgba(145, 90, 20, 0.96);
	}

	.privacy-label {
		font-size: 0.72rem;
		font-weight: 600;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(93, 81, 69, 0.58);
		padding-bottom: 0.25rem;
	}

	.privacy-preview__list {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
		font-size: 0.82rem;
		color: rgba(73, 64, 55, 0.74);
	}

	.privacy-preview__row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.9rem;
		font-size: 0.82rem;
		color: rgba(73, 64, 55, 0.82);
	}

	.privacy-preview__row--muted {
		margin-top: 0.7rem;
		justify-content: flex-start;
		color: rgba(93, 81, 69, 0.62);
		line-height: 1.55;
	}

	.privacy-preview__mono {
		font-size: 0.78rem;
		letter-spacing: 0.02em;
		color: rgba(44, 38, 32, 0.78);
		overflow-wrap: anywhere;
	}

	.privacy-preview__tag {
		display: inline-flex;
		align-items: center;
		padding: 0.24rem 0.48rem;
		border-radius: 999px;
		background: var(--privacy-card-pill-bg);
		font-size: 0.66rem;
		font-weight: 700;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: var(--privacy-card-pill-color);
	}

	.privacy-preview--stats {
		display: grid;
		gap: 0.8rem;
	}

	.privacy-preview__stat-row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		font-size: 0.82rem;
