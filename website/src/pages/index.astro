---
import darkShowcaseAsset from "../../assets/dark.webp";
import lightShowcaseAsset from "../../assets/light.webp";
import claudeAiLogo from "../../assets/claude-ai.svg";
import logoG from "../../assets/logo_g.PNG";
import mdNativeImg from "../../assets/md_native.png";
import Layout from "../layouts/Layout.astro";
import { downloadUrl } from "../lib/site";

const showcaseSizes = "(max-width: 1200px) 96vw, 1100px";
const showcaseWidth = lightShowcaseAsset.width;
const showcaseHeight = lightShowcaseAsset.height;
const pageTitle = "Glyph: Local-First Markdown Notes App for macOS";
const pageDescription =
	"Learn how Glyph helps you capture ideas with markdown notes, wikilinks, tasks, and local-first AI on macOS. Private by default, fast, and built for deep work.";
const softwareUrl = Astro.site ? new URL("/", Astro.site).toString() : "/";
const softwareJsonLd = [
	{
		"@context": "https://schema.org",
		"@type": "WebSite",
		name: "Glyph",
		url: softwareUrl,
		description: pageDescription,
		potentialAction: {
			"@type": "SearchAction",
			target: Astro.site
				? `${new URL("/docs", Astro.site).toString()}?q={search_term_string}`
				: "/docs?q={search_term_string}",
			"query-input": "required name=search_term_string",
		},
	},
	{
		"@context": "https://schema.org",
		"@type": "SoftwareApplication",
		name: "Glyph",
		applicationCategory: "ProductivityApplication",
		operatingSystem: "macOS",
		description: pageDescription,
		url: softwareUrl,
		offers: {
			"@type": "Offer",
			price: "0",
			priceCurrency: "USD",
		},
	},
];

const features = [
	{
		num: "01",
		cat: "EDITOR",
		title: "Markdown-native.",
		desc: "A distraction-free editor with a floating toolbar, slash commands, and live preview. Every note is a plain .md file you own forever.",
	},
	{
		num: "02",
		cat: "CONNECTIONS",
		title: "Wikilinks & backlinks.",
		desc: "Connect any idea to any other with [[wikilinks]]. See what links back. Your notes stay linked together — no folders, no silos.",
	},
	{
		num: "03",
		cat: "INTELLIGENCE",
		title: "AI that knows you.",
		desc: "Ask questions about your own notes. Summarize, compare, or draft — powered by your existing ChatGPT subscription (Plus, Team, or Pro), Anthropic, or a local model you control.",
	},
	{
		num: "04",
		cat: "PRODUCTIVITY",
		title: "Tasks, tables & boards.",
		desc: "Drop a checkbox in any note. Organize with tables and kanban boards. Glyph pulls tasks into Inbox, Today, and Upcoming — no separate app needed.",
	},
	{
		num: "05",
		cat: "SEARCH",
		title: "Find anything, instantly.",
		desc: "Hit ⌘P and find anything — by tag, folder, or full-text. Results appear before you finish typing.",
	},
	{
		num: "06",
		cat: "CUSTOMIZATION",
		title: "Make it yours.",
		desc: "Accent colors, custom fonts, daily notes, and shortcuts — bend Glyph to match how you think.",
	},
];

const faqs = [
	{
		q: "Is there a subscription?",
		a: "No. Glyph is a one-time purchase with lifetime access. No recurring fees, no seat limits, no device binding.",
	},
	{
		q: "Do you collect my data?",
		a: "Never. Your notes stay on your Mac as plain markdown files. Nothing is uploaded, tracked, or phoned home. Ever.",
	},
	{
		q: "Can I try it before buying?",
		a: 'Yes. Glyph comes with a 7-day free trial. No credit card required — just <a href="https://github.com/SidhuK/Glyph/releases" target="_blank" rel="noopener" style="text-decoration:underline">download the latest version</a> and start writing.',
	},
	{
		q: "I can't afford it at the listed price. What should I do?",
		a: 'Please reach out on <a href="https://x.com/karat_sidhu" target="_blank" rel="noopener" style="text-decoration:underline">X</a> or email <a href="mailto:karatsidhu@gmail.com" style="text-decoration:underline">karatsidhu@gmail.com</a>. If you are a student or really strapped for cash, I will happily send you a discount code or a free license key.',
	},
	{
		q: "Is it open source?",
		a: "Yes. The source code is public on GitHub. Official release binaries are licensed, but you can always build from source.",
	},
	{
		q: "Is a Windows version planned?",
		a: "Eventually, yes. Glyph is built with cross-platform technology, so Windows and Linux are absolutely possible. Right now, all my energy goes into making the Mac experience exceptional.",
	},
];
---

<Layout
	title={pageTitle}
	description={pageDescription}
	jsonLd={softwareJsonLd}
	preloadImage={lightShowcaseAsset.src}
	preloadImageSizes={showcaseSizes}
>
	<div class="page">

		<!-- ── HEADER ── -->
		<header class="header">
			<a href="/" class="logo">
				<img src={logoG.src} alt="" class="logo-icon" />
				<span>GLYPH</span>
				<span class="logo-version">EARLY ACCESS</span>
			</a>
			<nav class="nav">
				<a href="/docs/introduction">Docs</a>
				<a href="https://github.com/SidhuK/Glyph" target="_blank" rel="noopener">GitHub</a>
				<a href="/changelog">Changelog</a>
			</nav>
			<a href={downloadUrl} class="header-cta" target="_blank" rel="noopener">Download</a>
		</header>

		<!-- ── HERO ── -->
		<section class="hero">
			<h1>A quiet place for your<br />thoughts and ideas.<br /><span class="hero-accent">Always yours.</span></h1>
			<p class="hero-sub">Write in markdown. Connect ideas with links. Let AI help when you ask. Everything lives on your machine — plain files, always yours.</p>
			<p class="label">LOCAL-FIRST · MARKDOWN · MACOS</p>
			<div class="hero-cta-stack">
				<div class="hero-actions">
					<a href={downloadUrl} class="btn-primary" target="_blank" rel="noopener">
						<svg class="apple-logo" width="16" height="20" viewBox="0 0 814 1000" fill="currentColor" aria-hidden="true"><path d="M788.1 340.9c-5.8 4.5-108.2 62.2-108.2 190.5 0 148.4 130.3 200.9 134.2 202.2-.6 3.2-20.7 71.9-68.7 141.9-42.8 61.6-87.5 123.1-155.5 123.1s-85.5-39.5-164-39.5c-76.5 0-103.7 40.8-165.9 40.8s-105.6-57.8-155.5-127.4c-58.8-82-107.5-209.3-107.5-329.9 0-194.2 126.1-297.3 250.5-297.3 65.7 0 120.8 43.5 162 43.5 39.3 0 100.6-46 175.3-46 28.3 0 130.1 2.6 197.3 97.6zm-271.6-89.1c31.2-37 53.5-88.4 53.5-139.8 0-7.1-.6-14.3-1.9-20.1-51 1.9-111.6 33.9-148.4 76.5-26.4 30-55.9 81.3-55.9 133.4 0 7.8.6 15.6 1.3 18.2 2.6.6 6.4 1.3 10.2 1.3 45.8 0 103.8-30.6 141.2-69.5z"/></svg>
						Download for Free
					</a>
				</div>
				<p class="hero-trial">Free 7-day trial · No credit card required</p>
				<div class="install-strip" aria-label="Homebrew install command" data-install-strip>
					<div class="install-strip-bar">
						<code class="install-strip-code" data-install-command>brew install --cask SidhuK/glyph/glyph</code>
						<button class="install-strip-copy" type="button" data-copy-install aria-label="Copy Homebrew install command" title="Copy command">
							<svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<rect x="9" y="9" width="10" height="10" rx="2"></rect>
								<path d="M5 15V7a2 2 0 0 1 2-2h8"></path>
							</svg>
						</button>
					</div>
	
				</div>
				<p class="hero-pricing">or buy now · <span class="hero-pricing-original">$15</span> <strong>$9.99</strong> with code <code class="hero-pricing-code">EARLYACCESS</code></p>
			</div>
		</section>

		<!-- ── SHOWCASE ── -->
		<section class="showcase">
				<div class="showcase-wrap">
					<img
						class="showcase-img"
						src={lightShowcaseAsset.src}
						sizes={showcaseSizes}
						width={showcaseWidth}
						height={showcaseHeight}
						alt="Glyph in light mode"
						loading="eager"
						decoding="async"
						fetchpriority="high"
						data-light-src={lightShowcaseAsset.src}
						data-dark-src={darkShowcaseAsset.src}
						data-light-alt="Glyph in light mode"
						data-dark-alt="Glyph in dark mode"
					/>
			</div>
			<div class="mode-toggle-wrap">
				<button
					class="mode-toggle"
					type="button"
					data-mode-toggle
					aria-label="Switch between light and dark preview"
					aria-pressed="false"
				>
					<svg class="mode-icon icon-sun" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
					<svg class="mode-icon icon-moon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
				</button>
			</div>
		</section>

		<!-- ── FEATURES ── -->
		<section class="features-section" data-reveal>
			<div class="feature-card feature-card--wide feature-card--has-img">
				<div class="feature-card-text">
					<p class="feature-eyebrow">✏️ Editor</p>
					<h3 class="feature-heading">Markdown-native. Write without friction.</h3>
					<p class="feature-body">A distraction-free editor with a floating toolbar, slash commands, and live preview. Every note is a plain .md file you own forever.</p>
				</div>
				<div class="feature-card-img">
					<img src={mdNativeImg.src} alt="Glyph markdown editor with slash commands" loading="lazy" decoding="async" />
				</div>
			</div>
			<div class="feature-card-row">
				<div class="feature-card feature-card--has-img feature-card--stacked">
					<div class="feature-card-text">
						<p class="feature-eyebrow">🔗 Connections</p>
						<h3 class="feature-heading">Wikilinks & backlinks. Ideas stay connected.</h3>
						<p class="feature-body">Connect any idea to any other with [[wikilinks]]. See what links back. Your notes stay linked together — no folders, no silos.</p>
					</div>
						<div class="feature-card-img">
							<div class="feature-links-mini" aria-hidden="true">
								<svg class="feature-links-mini__lines" viewBox="0 0 240 170" preserveAspectRatio="none">
									<path d="M120 84 C101 68 82 52 60 39" />
									<path d="M120 84 C142 67 160 55 182 45" />
									<path d="M120 84 C102 102 84 117 66 131" />
									<path d="M120 84 C143 101 164 112 186 124" />
								</svg>
								<div class="feature-links-mini__node feature-links-mini__node--center">
									<span>Project Plan</span>
								</div>
							<div class="feature-links-mini__node feature-links-mini__node--top-left">
								<span>Daily Note</span>
							</div>
							<div class="feature-links-mini__node feature-links-mini__node--top-right">
								<span>Research</span>
							</div>
							<div class="feature-links-mini__node feature-links-mini__node--bottom-left">
								<span>Ideas</span>
							</div>
							<div class="feature-links-mini__node feature-links-mini__node--bottom-right">
								<span>Backlinks</span>
							</div>
						</div>
					</div>
				</div>
				<div class="feature-card feature-card--has-img feature-card--stacked">
					<div class="feature-card-text">
						<p class="feature-eyebrow">🧠 Intelligence</p>
						<h3 class="feature-heading">AI that knows your notes.</h3>
						<p class="feature-body">Ask questions about your own notes. Summarize, compare, or draft — powered by your existing ChatGPT subscription, Anthropic, or a local model.</p>
						</div>
						<div class="feature-card-img">
								<div class="feature-ai-mini" aria-hidden="true">
									<div class="feature-ai-mini__message feature-ai-mini__message--user">
										Compare my last three project notes and draft a short update I can send.
									</div>
									<div class="feature-ai-mini__message feature-ai-mini__message--assistant">
										<span class="feature-ai-mini__logo">
											<img src={claudeAiLogo.src} alt="" loading="lazy" decoding="async" />
										</span>
										<span class="feature-ai-mini__response">
											<strong>Claude</strong>
											<span>Across your recent notes, three themes keep resurfacing: launch scope, onboarding friction, and unresolved pricing. Draft update: We are aligned on direction, but onboarding and pricing still need decisions before launch.</span>
										</span>
									</div>
								</div>
						</div>
				</div>
			</div>
			<div class="feature-card feature-card--wide feature-card--has-img">
				<div class="feature-card-text">
					<p class="feature-eyebrow">✅ Productivity</p>
					<h3 class="feature-heading">Tasks, tables & boards. All in one place.</h3>
					<p class="feature-body">Drop a checkbox in any note. Organize with tables and kanban boards. Glyph pulls tasks into Inbox, Today, and Upcoming — no separate app needed.</p>
				</div>
				<div class="feature-card-img">
					<div class="feature-sidebar-mini" aria-hidden="true">
						<div class="feature-sidebar-mini__item" data-kind="daily-note">
							<span class="feature-sidebar-mini__icon">
								<svg viewBox="0 0 16 16" aria-hidden="true">
									<path d="M4.5 2.75v2.5M11.5 2.75v2.5M2.75 6h10.5M3.75 4.25h8.5a1 1 0 0 1 1 1v6a1.5 1.5 0 0 1-1.5 1.5h-7.5a1.5 1.5 0 0 1-1.5-1.5v-6a1 1 0 0 1 1-1ZM8 7.5v3M6.5 9h3" />
								</svg>
							</span>
							<span>Daily Note</span>
						</div>
						<div class="feature-sidebar-mini__item" data-kind="tasks">
							<span class="feature-sidebar-mini__icon">
								<svg viewBox="0 0 16 16" aria-hidden="true">
									<path d="M3 4.25h7.25M3 8h7.25M3 11.75h7.25M11.5 4.5l1 1 2-2M11.5 8.25l1 1 2-2" />
								</svg>
							</span>
							<span>Tasks</span>
						</div>
						<div class="feature-sidebar-mini__item" data-kind="calendar">
							<span class="feature-sidebar-mini__icon">
								<svg viewBox="0 0 16 16" aria-hidden="true">
									<path d="M4.5 2.75v2.5M11.5 2.75v2.5M2.75 6h10.5M3.75 4.25h8.5a1 1 0 0 1 1 1v6a1.5 1.5 0 0 1-1.5 1.5h-7.5a1.5 1.5 0 0 1-1.5-1.5v-6a1 1 0 0 1 1-1Z" />
								</svg>
							</span>
							<span>Calendar</span>
						</div>
					</div>
				</div>
			</div>
			<div class="feature-card-row">
				<div class="feature-card">
					<div class="feature-card-text">
						<p class="feature-eyebrow">🔍 Search</p>
						<h3 class="feature-heading">Find anything, instantly.</h3>
						<p class="feature-body">Hit ⌘P and find anything — by tag, folder, or full-text. Results appear before you finish typing.</p>
						<div class="feature-command-mini" aria-hidden="true">
							<div class="feature-command-mini__input">
								<span class="feature-command-mini__search-icon">
									<svg viewBox="0 0 16 16" aria-hidden="true">
										<circle cx="7" cy="7" r="3.5" />
										<path d="M10 10l3 3" />
									</svg>
								</span>
								<span class="feature-command-mini__query">meeting notes</span>
								<span class="feature-command-mini__shortcut">⌘P</span>
							</div>
							<div class="feature-command-mini__results">
								<div class="feature-command-mini__label">Notes</div>
								<div class="feature-command-mini__item is-active">
									<strong>Weekly Review</strong>
									<small>work/meetings</small>
								</div>
								<div class="feature-command-mini__item">
									<strong>Meeting Notes</strong>
									<small>inbox</small>
								</div>
								<div class="feature-command-mini__item">
									<strong>#planning</strong>
									<small>tag match</small>
								</div>
							</div>
						</div>
					</div>
				</div>
				<div class="feature-card">
					<div class="feature-card-text">
						<p class="feature-eyebrow">🎨 Customization</p>
						<h3 class="feature-heading">Make it yours.</h3>
						<p class="feature-body">Accent colors, custom fonts, daily notes, and shortcuts — bend Glyph to match how you think.</p>
						<div class="feature-customize-mini" aria-hidden="true">
							<div class="feature-customize-mini__themes">
								<span class="is-active">Paper</span>
								<span>Graphite</span>
								<span>Tokyo Night</span>
								<span>Nord</span>
								<span>Solarized</span>
								<span>Dracula</span>
								<span>GitHub</span>
							</div>
							<div class="feature-customize-mini__swatches">
								<span style="background:#0081a7"></span>
								<span style="background:#00afb9"></span>
								<span style="background:#fdfcdc"></span>
								<span style="background:#fed9b7"></span>
								<span style="background:#f07167"></span>
							</div>
							<div class="feature-customize-mini__type">
								<div class="feature-customize-mini__sample">
									<span class="feature-customize-mini__title">Today</span>
									<span class="feature-customize-mini__meta">Avenir Next · 14px</span>
								</div>
								<div class="feature-customize-mini__shortcut">⌘⇧J</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- ── LOCAL-FIRST ── -->
		<section class="section" data-reveal>
			<p class="label">PRIVACY</p>
			<h2>Yours, completely</h2>
			<p class="section-sub">Your notes never leave your machine. No account, no cloud, no telemetry. Open a folder and start writing.</p>
			<div class="privacy-grid">
				<div class="privacy-cell privacy-cell--tip">
					<p class="privacy-stat">0</p>
					<p class="privacy-label">data collected</p>
					<div class="tip-card">
						<p class="tip-title">Private by default</p>
						<ul class="tip-list">
							<li>No account required to use Glyph</li>
							<li>No telemetry, tracking, or sync layer</li>
							<li>Your notes stay available even without internet</li>
						</ul>
						<p class="tip-foot">Glyph works locally first, so privacy and offline access are built in from the start.</p>
					</div>
				</div>
				<div class="privacy-cell privacy-cell--tip">
					<p class="privacy-stat">.md</p>
					<p class="privacy-label">plain files you own</p>
					<div class="tip-card">
						<p class="tip-title">No lock-in</p>
						<ul class="tip-list">
							<li>Every note is saved as a standard markdown file</li>
							<li>Open your folder anytime in Finder or another editor</li>
							<li>Your notes stay yours, even if you stop using Glyph</li>
						</ul>
						<p class="tip-foot">Glyph organizes your notes without trapping them in a proprietary format.</p>
					</div>
				</div>
				<div class="privacy-cell privacy-cell--tip">
					<p class="privacy-stat">&lt;40<span class="privacy-unit">MB</span></p>
					<p class="privacy-label">app size</p>
					<div class="tip-card">
						<p class="tip-title">Why so small?</p>
						<ul class="tip-list">
							<li>Built natively with Tauri &amp; Rust</li>
							<li>No Electron, no bundled browser</li>
							<li>Uses under 250 MB of memory</li>
						</ul>
						<p class="tip-foot">A lean, fast app that respects your disk and your battery.</p>
					</div>
				</div>
				<div class="privacy-cell privacy-cell--tip">
					<p class="privacy-stat">BYOK</p>
					<p class="privacy-label">bring your own AI key</p>
					<div class="tip-card">
						<p class="tip-title">Supported providers</p>
						<ul class="tip-list">
							<li>OpenAI / ChatGPT (Plus, Team, Pro)</li>
							<li>Anthropic (Claude)</li>
							<li>Google Gemini</li>
							<li>OpenRouter</li>
							<li>Local models (Ollama, LM Studio)</li>
						</ul>
						<p class="tip-foot">Use your own API key — I never store or proxy it.</p>
					</div>
				</div>
			</div>
		</section>

		<!-- ── DESIGN ── -->
		<section class="section" data-reveal>
			<p class="label">DESIGN</p>
			<h2>Obsessively crafted</h2>
			<p class="section-sub">A native macOS app built by a solo developer who sweats the details. Every pixel, every shortcut, every transition.</p>
		</section>

		<!-- ── FAQ ── -->
		<section class="section" data-reveal>
			<p class="label">FREQUENT CONCERNS</p>
			<h2>Everything you need to<br />know before you begin</h2>
			<div class="faq-list">
				{faqs.map((f) => (
					<details class="faq-item">
						<summary class="faq-summary">
							<span class="faq-q">{f.q}</span>
							<span class="faq-plus">+</span>
						</summary>
						<p class="faq-a" set:html={f.a} />
					</details>
				))}
			</div>
		</section>

		<!-- ── CTA ── -->
		<section class="section cta" data-reveal>
			<p class="label">YOUR NEXT STEP</p>
			<h2>Start writing with<br />Glyph today</h2>
			<div class="cta-actions">
				<a href={downloadUrl} class="btn-primary" target="_blank" rel="noopener">Get Glyph</a>
				<a href="https://github.com/SidhuK/Glyph" class="btn-github" target="_blank" rel="noopener">
					<svg class="btn-github-mark" viewBox="0 0 438.549 438.549" aria-hidden="true">
