#!/usr/bin/env bash
# Saves a PNG of the Glyph window. Usage: capture-screenshot [output.png]
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$repo_root"
export DISPLAY="${DISPLAY:-:99}"

output="${1:-.amp/in/artifacts/glyph-$(date +%Y%m%d-%H%M%S).png}"
mkdir -p "$(dirname "$output")"
window="$(.agents/wait-for-visual-window "${GLYPH_VISUAL_TIMEOUT:-600}")"
import -display "$DISPLAY" -window "$window" "$output"
printf '%s\n' "$output"
